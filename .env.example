# Add Supabase values after creating a project at https://supabase.com.
# The public values are safe for browser use; never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Add these only when the server-side email integration is implemented.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
